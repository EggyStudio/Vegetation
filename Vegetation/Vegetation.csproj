<Project Sdk="Microsoft.NET.Sdk">

    <!-- The library both engines reference from their own projects, which knows no engine (N 2.1). -->
    <PropertyGroup>
        <RootNamespace>Vegetation</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Every public member has a summary (STYLE.md), so a missing one stops the build, as a cref that
         names nothing does. -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1574</WarningsAsErrors>
    </PropertyGroup>

    <!-- The texture collection and its manifest, which TreeTextures reads from the assembly, so an
         engine and a game carry no folder for them. The sets waiting for their source are left out,
         as they are left out of the repository, so a build on a machine that imported them carries
         none of them. -->
    <ItemGroup>
        <EmbeddedResource Include="Textures/textures.json" LogicalName="Vegetation/Textures/textures.json"/>
        <EmbeddedResource Include="Textures/**/*.ktx2" Exclude="Textures/waiting/**"
                          LogicalName="Vegetation/Textures/%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
